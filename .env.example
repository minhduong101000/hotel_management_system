# Copy thành .env rồi điền giá trị thật. Sinh secret: openssl rand -hex 32
# APP_ENV: development | testing | production
APP_ENV=development
SECRET_KEY=changeme-openssl-rand-hex-32-toi-thieu-32-ky-tu
DATABASE_URL=mysql+pymysql://hotel:changeme@localhost:3306/hotel

# Cho container db (docker compose)
MYSQL_ROOT_PASSWORD=changeme-root
MYSQL_DATABASE=hotel
MYSQL_USER=hotel
MYSQL_PASSWORD=changeme

# Bootstrap dữ liệu mẫu (flask seed-development — chỉ chạy ở development,
# yêu cầu Hotel với slug này đã tồn tại; mật khẩu tối thiểu 12 ký tự)
HOTEL_SLUG=central
ADMIN_PASSWORD=changeme-toi-thieu-12-ky-tu
STAFF_PASSWORD=changeme-toi-thieu-12-ky-tu

# Tùy chọn: gửi mail (Flask-Mail) — bỏ trống nếu chưa dùng
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=app-password
# MAIL_DEFAULT_SENDER=you@gmail.com

# Tùy chọn: thông tin khách sạn hiển thị (HOTEL_NAME, HOTEL_BRANCH,
# HOTEL_ADDRESS, HOTEL_PHONE, HOTEL_EMAIL, HOTEL_LOGO_URL)

# Test tích hợp MySQL (pytest -m mysql) — cần DB gốc tên chứa "test",
# user có quyền CREATE/DROP DATABASE (fixture tạo DB tạm hotel_test_xxxx):
#   docker compose exec db mysql -uroot -p$MYSQL_ROOT_PASSWORD \
#     -e "CREATE DATABASE IF NOT EXISTS hotel_test"
#   TEST_MYSQL_DATABASE_URL=... venv/bin/python -m pytest -m mysql
TEST_MYSQL_DATABASE_URL=mysql+pymysql://root:changeme-root@127.0.0.1:3306/hotel_test

# --- Production hardening (15-08) ---
# Domain public de Caddy tu cap HTTPS (bo trong = phuc vu HTTP :80,
# khi do phai dat SESSION_COOKIE_SECURE=false neu chay LAN thuan HTTP)
DOMAIN=
SESSION_COOKIE_SECURE=true
WEB_CONCURRENCY=2
BACKUP_RETENTION_DAYS=14

# Cảnh báo vận hành qua Telegram (spec 22-08-2026).
# Để TRỐNG hai dòng đầu = tắt hẳn, không gọi mạng. Lấy token bằng cách nhắn
# /newbot cho @BotFather; lấy chat_id ở api.telegram.org/bot<TOKEN>/getUpdates.
# Xem docs/runbooks/telegram-alerts.md
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_INTERVAL_SECONDS=300
ALERT_WEB_URL=http://web:8000/healthz
ALERT_WEB_FAIL_THRESHOLD=2
ALERT_BACKUP_DIR=/backups
ALERT_BACKUP_MAX_AGE_HOURS=26
ALERT_DISK_THRESHOLD_PERCENT=85
ALERT_REPEAT_HOURS=6
ALERT_SUMMARY_HOUR=7
ALERT_STATE_FILE=/state/alerts.json
